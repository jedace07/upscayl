{
  "id": "org.upscayl.Upscayl",
  "sdk": "org.freedesktop.Sdk",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "base": "org.electronjs.Electron2.BaseApp",
  "base-version": "24.08",
  "command": "upscayl",
  "separate-locales": false,
  "finish-args": [
    "--device=dri",
    "--filesystem=home",
    "--share=network",
    "--socket=x11",
    "--socket=wayland",
    "--share=ipc",
    "--socket=pulseaudio",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "modules": [
    {
      "name": "upscayl",
      "buildsystem": "simple",
      "sources": [
        {
          "type": "archive",
          "url": "https://registry.npmjs.org/upscayl/-/upscayl-2.15.0.tgz",
          "sha256": "PLACEHOLDER_SHA256"
        },
        {
          "type": "file",
          "path": "org.upscayl.Upscayl.metainfo.xml"
        },
        {
          "type": "file",
          "path": "org.upscayl.Upscayl.desktop"
        }
      ],
      "build-commands": [
        "mkdir -p /app/upscayl",
        "tar xzf upscayl-2.15.0.tgz -C /app/upscayl/",
        "install -Dm755 /app/upscayl/package/linux-unpacked/upscayl /app/upscayl/upscayl",
        "install -Dm755 /app/upscayl/package/linux-unpacked/chrome-sandbox /app/upscayl/chrome-sandbox",
        "chmod 4755 /app/upscayl/chrome-sandbox",
        "install -Dm644 /app/upscayl/package/resources/icons/128x128.png /app/share/icons/hicolor/128x128/apps/org.upscayl.Upscayl.png",
        "install -Dm644 /app/upscayl/package/resources/icons/512x512.png /app/share/icons/hicolor/512x512/apps/org.upscayl.Upscayl.png",
        "install -Dp -m644 org.upscayl.Upscayl.metainfo.xml /app/share/metainfo/org.upscayl.Upscayl.metainfo.xml",
        "install -Dp -m644 org.upscayl.Upscayl.desktop /app/share/applications/org.upscayl.Upscayl.desktop",
        "touch /app/upscayl/org.upscayl.Upscayl.desktop"
      ]
    }
  ]
}
